# Conexión a PostgreSQL (15+). Con `docker compose up -d` estos valores funcionan tal cual.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plantilla"

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Opcional: modelo a usar (por defecto gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"
