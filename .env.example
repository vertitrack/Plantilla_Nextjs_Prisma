# Conexión a PostgreSQL (15+). Con `docker compose up -d` estos valores funcionan tal cual.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plantilla"

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Opcional: modelo a usar (por defecto gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"
# Opcional: modelo de respaldo si el principal está saturado (vacío lo desactiva)
# GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

# Contraseña para entrar a la app (mínimo 12 caracteres). Úsala larga y única.
APP_PASSWORD=""
# Secreto para firmar la cookie de sesión (genera uno con: openssl rand -base64 32).
# Cambiarlo, o cambiar APP_PASSWORD, cierra todas las sesiones abiertas.
AUTH_SECRET=""
